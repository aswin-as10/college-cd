//calc.l
%{
#include "y.tab.h"
#include <stdlib.h>
%}

%%
[0-9]+  { yylval = atoi(yytext); return NUMBER; }
[ \t]   ;
\n      { return '\n'; }
.       { return yytext[0]; }
%%

int yywrap()
{
    return 1;
}
//calc.y

%{
#include <stdio.h>
%}

%token NUMBER
%left '+' '-'
%left '*' '/'

%%
input:
      /* empty */
    | input line
    ;

line:
      '\n'
    | expr '\n' { printf("Result = %d\n", $1); }
    ;

expr:
      NUMBER          { $$ = $1; }
    | expr '+' expr   { $$ = $1 + $3; }
    | expr '-' expr   { $$ = $1 - $3; }
    | expr '*' expr   { $$ = $1 * $3; }
    | expr '/' expr   {
                          if ($3 == 0)
                          {
                              printf("Division by zero error\n");
                              $$ = 0;
                          }
                          else
                              $$ = $1 / $3;
                      }
    ;
%%

int main()
{
    printf("Enter expressions (Ctrl+D to exit):\n");
    return yyparse();
}

int yyerror(char *s)
{
    printf("Invalid expression\n");
    return 0;
}

